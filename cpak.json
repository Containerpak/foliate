{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Foliate",
  "description": "Read EPUB, MOBI, AZW and comic book files.",
  "version": "3.3.0",
  "image": "ghcr.io/containerpak/foliate@sha256:b96532d52989251003b779bb6dcbcecbe28a610b742a2e75c2be522b6257704d",
  "binaries": [
    "/usr/bin/foliate"
  ],
  "desktop_entries": [
    "/usr/share/applications/com.github.johnfactotum.Foliate.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": true,
    "hostApplications": false,
    "hostActions": [],
    "filesystem": [
      {
        "path": "xdg-documents",
        "access": "read-write"
      },
      {
        "path": "xdg-download",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
